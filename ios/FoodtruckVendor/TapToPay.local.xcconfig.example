// For a direct local-device build, copy this file to TapToPay.local.xcconfig.
// That file is ignored by Git. Production EAS builds generate the same ignored
// file from secure CYBERSOURCE_TTP_* build environment variables.
// Do not put these values in EXPO_PUBLIC variables, JavaScript, source code, or Git.
// Obtain both values from CyberSource Business Center > Key Management.
CYBERSOURCE_TTP_MERCHANT_ID = REPLACE_WITH_ACCEPTANCE_DEVICES_MERCHANT_ID
CYBERSOURCE_TTP_ACCEPTANCE_DEVICE_SECRET = REPLACE_WITH_ACCEPTANCE_DEVICES_SECRET_KEY
// Keep blank. For a one-time reactivation, the SDK prompts the merchant to
// enter the serial copied from the failed-enrollment screen.
CYBERSOURCE_TTP_DEVICE_ID =
// Set to YES only for a recovery build. The SDK will prompt for the copied
// serial. Set it back to NO after a successful reactivation.
CYBERSOURCE_TTP_RESET_ENROLLMENT = NO
